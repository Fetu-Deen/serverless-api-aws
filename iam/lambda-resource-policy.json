{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowApiGatewayPostSubmit",
      "Effect": "Allow",
      "Principal": {
        "Service": "apigateway.amazonaws.com"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-west-2:ACCOUNT_ID:function:students-submit",
      "Condition": {
        "ArnLike": {
          "AWS:SourceArn": "arn:aws:execute-api:us-west-2:ACCOUNT_ID:API_ID/*/POST/submit"
        }
      }
    }
  ]
}
