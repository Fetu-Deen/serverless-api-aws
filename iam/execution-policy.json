{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteStudents",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:us-west-2:ACCOUNT_ID:table/coderco"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-west-2:ACCOUNT_ID:log-group:/aws/lambda/students-submit",
        "arn:aws:logs:us-west-2:ACCOUNT_ID:log-group:/aws/lambda/students-submit:*"
      ]
    }
  ]
}
